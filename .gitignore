# Build artifacts
__pycache__/
*.pyc

# Licensed Definitive Healthcare exports — do not redistribute.
# Confirm terms with the licence owner before these leave this machine.
Definitive_*.xlsx
# Per-run snapshots of the Databricks-held Definitive tables - same licence.
*_dhc_*.parquet

# Every run writes into its own folder here - Zeus client data, Definitive
# snapshots and the workbooks built from them. Ignored wholesale; the suffix
# rules below still catch any file written outside it.
Results Output/

# Run outputs: Zeus client data (names, addresses), regenerable from the
# query + sources.yaml. Keep <out>_zeus_extract.csv alongside any circulated
# result — it is the only way to reproduce a figure later.
#
# Matched on the OUTPUT SUFFIX, not on an `audit_` prefix. The prefix is chosen
# per run with --out, so a new tool or a differently-named run would otherwise
# write client data straight past these rules — gap_probe_zeus_extract.csv did
# exactly that on 2026-08-19.
*_scored.csv
*_unverifiable.csv
*_zeus_extract.csv
*_gap_candidates.csv
*_gap_nomatch.csv
*_hierarchy.csv
# dhc_hierarchy.py edge lists and every zeus_hierarchy.py output (2026-10-07)
*_hierarchy_*.csv
*_contradictions.csv
*_zeus_links_replaced.csv
*_zeus_links_dropped.csv
*_resolution.csv
*_zeus_links.csv
*_zeus_linked_imports.csv
*_zeus_duplicates.csv

# Generated deliverables. Both carry Zeus client names and addresses, so match
# the family rather than one audit's name — the Coverage workbook was written
# straight past the Accuracy-only rule on 2026-08-19.
Zeus_DHC_ID_*.xlsx
Zeus_Entity_Hierarchy*.xlsx
Definitive_Hospital_Hierarchy*.xlsx
Definitive_Ownership_Hierarchy*.xlsx

# Secrets, in case one ever lands here
.env
*.local.yaml

# Local tool state
.sf/

.databricks
